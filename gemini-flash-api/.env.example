# Salin jadi .env untuk development lokal.
# Di Dokploy, isi nilai-nilai ini lewat tab Environment (jangan commit .env).

# Wajib — ambil gratis di https://ai.google.dev
GEMINI_API_KEY=

# Opsional — Dokploy mengisi otomatis, default 3000
PORT=3000

# Wajib diisi 1 di Dokploy: server ada di belakang reverse proxy Traefik,
# supaya rate limit membaca IP asli pengunjung, bukan IP proxy.
# Biarkan 0 saat menjalankan langsung di laptop.
TRUST_PROXY=0
