# Salin jadi .env untuk development lokal.
# Di Dokploy, isi nilai-nilai ini lewat tab Environment (jangan commit .env).

# Wajib — model untuk pesan teks biasa
API_KEY_AI=
BASE_URL_AI=https://ai.sumopod.com/v1
MODEL_AI=MiniMax-M2.7-highspeed

# Wajib — model untuk pesan berlampiran (screenshot, pesan suara).
# MiniMax di atas tidak bisa melihat gambar / mendengar audio, jadi pesan
# yang membawa lampiran dialihkan ke model dan kunci ini. Base URL sama
# (satu penyedia), tapi kuncinya sengaja terpisah — paket/kuota berbeda.
MODEL_AI_MULTIMODAL=gemini/gemini-3.1-flash-lite
API_KEY_AI_MULTIMODAL=

# Opsional — Dokploy mengisi otomatis, default 3000
PORT=3000

# Wajib diisi 1 di Dokploy: server ada di belakang reverse proxy Traefik,
# supaya rate limit membaca IP asli pengunjung, bukan IP proxy.
# Biarkan 0 saat menjalankan langsung di laptop.
TRUST_PROXY=0
